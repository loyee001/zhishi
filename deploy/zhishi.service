[Unit]
Description=Zhishi personal plant care
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zhishi
Group=zhishi
WorkingDirectory=/opt/zhishi/current
EnvironmentFile=/etc/zhishi.env
ExecStart=/opt/zhishi/runtime/node /opt/zhishi/current/server.mjs
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zhishi

[Install]
WantedBy=multi-user.target
