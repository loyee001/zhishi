# These are shell/systemd configuration values; the app does not auto-load .env.
PORT=18188
# Empty BASE_PATH serves the dedicated domain at its root; /plants remains supported.
BASE_PATH=
PUBLIC_ORIGIN=https://zhi.qdfb.tech
PLANT_DATA_DIR=/var/lib/zhishi
PLANT_PHOTO_PROVIDER=inaturalist
TZ=Asia/Shanghai
